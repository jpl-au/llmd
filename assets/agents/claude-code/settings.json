{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(curl *)",
      "Bash(go *)",
      "Bash(goimports *)",
      "Bash(git *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(find *)",
      "mcp__llmd__*"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "llmd --author {{.Agent}} queue send 'Agent stop: task {{.TaskID}}' 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
