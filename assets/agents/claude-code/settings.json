{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(curl *)",
      "Bash(go *)",
      "Bash(goimports *)",
      "Bash(git *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(find *)",
      "mcp__llmd__*"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf{{.Auth}} -X POST '{{.URL}}/hook?task={{.TaskID}}' -H 'Author: {{.Agent}}' --data-binary @- >/dev/null || true"
          }
        ]
      }
    ]
  }
}
